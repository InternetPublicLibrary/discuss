// discuss — Cloudflare Workers configuration (spec 001). Top level = local development and tests.
// Secrets are never committed: see README "Configuration".
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ipl-discuss-dev",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // The widget build; the Worker answers /api/* first and serves everything else from here.
  "assets": { "directory": "./dist/widget", "binding": "ASSETS", "run_worker_first": ["/api/*", "/widget", "/", "/index.html"] },
  "kv_namespaces": [{ "binding": "DISCUSS_KV", "id": "discuss-kv-dev" }],
  "durable_objects": { "bindings": [{ "name": "DISCUSSION_LOCK", "class_name": "DiscussionLock" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DiscussionLock"] }],
  "vars": {
    "ENVIRONMENT": "development",
    "IPL_ALLOWED_ORIGINS": "http://localhost:4000",
    "ALLOWED_REPOSITORIES": "InternetPublicLibrary/discuss-sandbox"
  },
  "env": {
    "staging": {
      "name": "ipl-discuss-staging",
      "durable_objects": { "bindings": [{ "name": "DISCUSSION_LOCK", "class_name": "DiscussionLock" }] },
      "workers_dev": false,
      "routes": [{ "pattern": "discuss.staging.ipl.better-web.org", "custom_domain": true }],
      "kv_namespaces": [{ "binding": "DISCUSS_KV", "id": "REPLACE_WITH_STAGING_KV_ID" }],
      "vars": { "ENVIRONMENT": "staging", "IPL_ALLOWED_ORIGINS": "https://staging.ipl.better-web.org", "ALLOWED_REPOSITORIES": "InternetPublicLibrary/discuss-sandbox" }
    },
    "production": {
      "name": "ipl-discuss",
      "durable_objects": { "bindings": [{ "name": "DISCUSSION_LOCK", "class_name": "DiscussionLock" }] },
      "workers_dev": false,
      "routes": [{ "pattern": "discuss.ipl.better-web.org", "custom_domain": true }],
      "kv_namespaces": [{ "binding": "DISCUSS_KV", "id": "REPLACE_WITH_PRODUCTION_KV_ID" }],
      "vars": { "ENVIRONMENT": "production", "IPL_ALLOWED_ORIGINS": "https://ipl.better-web.org", "ALLOWED_REPOSITORIES": "InternetPublicLibrary/en-US,InternetPublicLibrary/pt-BR" }
    }
  }
}
