{
  "name": "@ipl/discuss",
  "version": "0.1.0",
  "private": true,
  "description": "Internet Public Library comments: GitHub Discussions with GitHub and ORCID sign-in (hard fork of giscus)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:widget && wrangler dev",
    "build": "npm run build:widget",
    "build:widget": "vite build && vite build --config vite.client.config.ts && node scripts/build-themes.mjs",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "typecheck": "tsc -p tsconfig.worker.json && tsc -p tsconfig.widget.json && tsc -p tsconfig.e2e.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run budget",
    "budget": "node scripts/check-budget.mjs",
    "test:e2e": "playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InternetPublicLibrary/discuss.git"
  },
  "homepage": "https://github.com/InternetPublicLibrary/discuss#readme",
  "dependencies": {
    "@primer/octicons-react": "^19.40.0",
    "dompurify": "^3.4.17",
    "hono": "^4.13.13",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "^7.29.7",
    "@cloudflare/vitest-plugin": "^1.4.3",
    "@cloudflare/workers-types": "^5.20261015.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "22.19.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.30",
    "tailwindcss": "^3.4.19",
    "tailwindcss-vanilla-rtl": "^0.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.149.0"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true,
    "fsevents": false
  },
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
